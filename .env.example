# Copy this file to `.env` (which is gitignored) and fill in your actual values.
# Get these from your Supabase project dashboard:
#   - SUPABASE_URL / SUPABASE_KEY   -> Project Settings -> API
#   - SUPABASE_DB_*                  -> Project Settings -> Database -> Connection parameters
#
# For GitHub Actions, add the same values as repository secrets instead
# (Settings -> Secrets and variables -> Actions) — do NOT commit .env.

SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
