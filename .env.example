# Copy this file to `.env` (which is gitignored) and fill in your actual value.
# Get it from the Neon console: your project -> Connect -> copy the connection
# string (keep "Connection pooling" ON; it looks like the example below).
#
# For GitHub Actions, add the same value as a repository secret named
# DATABASE_URL (Settings -> Secrets and variables -> Actions) -- do NOT commit .env.
# For Streamlit Community Cloud, add DATABASE_URL under the app's Settings -> Secrets.

DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
